{
  "name": "ets666-tool",
  "version": "1.0.0",
  "private": true,
  "author": "Your Name",
  "description": "Vue 3 + Electron Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode electron",
    "dev:web": "vite",
    "build": "vue-tsc && vite build",
    "build:electron": "vue-tsc && vite build --mode electron",
    "pack": "electron-builder --dir",
    "pack:win": "npm run build:electron && electron-builder --win --x64 --ia32",
    "pack:mac": "npm run build:electron && electron-builder --mac --x64 --arm64",
    "pack:linux": "npm run build:electron && electron-builder --linux --x64",
    "pack:all": "npm run build:electron && electron-builder -mwl",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:linux": "npm run build:electron && electron-builder --linux"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "element-plus": "^2.6.1",
    "vue-i18n": "^9.10.2",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.1.6",
    "typescript": "^5.4.2",
    "vue-tsc": "^2.0.6",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "@types/node": "^20.11.28",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.1"
  }
}